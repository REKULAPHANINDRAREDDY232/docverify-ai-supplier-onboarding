generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPPLIER_CONTACT
  REVIEWER
  ADMIN
}

enum SupplierStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_INFORMATION
  APPROVED
  ON_HOLD
}

enum DocumentStatus {
  ACTIVE
  REPLACED
}

enum ChecklistStatus {
  PRESENT
  MISSING
  NEEDS_REVIEW
  NOT_APPLICABLE
}

enum ReviewDecision {
  APPROVED
  ON_HOLD
  NEEDS_INFORMATION
}

enum DocumentRequestStatus {
  OPEN
  RESOLVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplierAsContact Supplier?          @relation("SupplierContact")
  uploadedDocuments SupplierDocument[] @relation("DocumentUploader")
  checklistChecks   ChecklistCheck[]   @relation("ChecklistChecker")
  reviewActions     ReviewAction[]     @relation("ReviewerActions")
  documentRequests  DocumentRequest[]  @relation("DocumentRequester")
  auditLogs         AuditLog[]         @relation("AuditActor")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Supplier {
  id                 String         @id @default(cuid())
  companyName        String
  legalName          String
  tradingName        String?
  registrationNumber String?
  contactPerson      String
  contactEmail       String
  contactUserId      String         @unique
  status             SupplierStatus @default(DRAFT)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  contactUser       User               @relation("SupplierContact", fields: [contactUserId], references: [id], onDelete: Restrict)
  documents         SupplierDocument[]
  checklistChecks   ChecklistCheck[]
  reviewActions     ReviewAction[]
  documentRequests  DocumentRequest[]

  @@index([status])
  @@index([companyName])
  @@index([registrationNumber])
  @@index([contactEmail])
  @@map("suppliers")
}

model DocumentType {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  required    Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  documents        SupplierDocument[]
  checklistItems   ChecklistItem[]
  documentRequests DocumentRequest[]

  @@index([active, required])
  @@map("document_types")
}

model SupplierDocument {
  id                   String         @id @default(cuid())
  supplierId           String
  documentTypeId       String
  originalFilename     String
  storedFilename       String
  storagePath          String
  mimeType             String
  fileSize             Int
  status               DocumentStatus @default(ACTIVE)
  uploadedById         String
  uploadedAt           DateTime       @default(now())
  supersededDocumentId String?

  supplier           Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  documentType       DocumentType     @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  uploadedBy         User             @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  supersededDocument SupplierDocument?  @relation("DocumentSupersession", fields: [supersededDocumentId], references: [id], onDelete: SetNull)
  supersedingDocuments SupplierDocument[] @relation("DocumentSupersession")

  @@index([supplierId, documentTypeId])
  @@index([status])
  @@index([uploadedById])
  @@index([supersededDocumentId])
  @@map("supplier_documents")
}

model ChecklistItem {
  id             String    @id @default(cuid())
  title          String
  description    String?
  documentTypeId String?
  isRequired     Boolean   @default(true)
  isActive       Boolean   @default(true)
  version        String
  effectiveDate  DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  documentType DocumentType?    @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  checks       ChecklistCheck[]

  @@index([documentTypeId])
  @@index([isActive, isRequired])
  @@index([version])
  @@map("checklist_items")
}

model ChecklistCheck {
  id              String          @id @default(cuid())
  supplierId      String
  checklistItemId String
  status          ChecklistStatus
  comment         String?
  checkedById     String
  checkedAt       DateTime        @default(now())

  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)
  checkedBy     User          @relation("ChecklistChecker", fields: [checkedById], references: [id], onDelete: Restrict)

  @@unique([supplierId, checklistItemId])
  @@index([status])
  @@index([checkedById])
  @@map("checklist_checks")
}

model ReviewAction {
  id         String         @id @default(cuid())
  supplierId String
  reviewerId String
  decision   ReviewDecision
  comment    String?
  createdAt  DateTime       @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  reviewer User     @relation("ReviewerActions", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([supplierId, createdAt])
  @@index([reviewerId])
  @@index([decision])
  @@map("review_actions")
}

model DocumentRequest {
  id             String                @id @default(cuid())
  supplierId     String
  reviewerId     String
  documentTypeId String
  message        String
  status         DocumentRequestStatus @default(OPEN)
  createdAt      DateTime              @default(now())
  resolvedAt     DateTime?

  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  reviewer     User         @relation("DocumentRequester", fields: [reviewerId], references: [id], onDelete: Restrict)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  @@index([supplierId, status])
  @@index([reviewerId])
  @@index([documentTypeId])
  @@map("document_requests")
}

model ReferenceSource {
  id                String   @id @default(cuid())
  title             String
  version           String
  effectiveDate     DateTime
  sourceDescription String
  createdAt         DateTime @default(now())

  @@unique([title, version])
  @@index([effectiveDate])
  @@map("reference_sources")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
