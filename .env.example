# Shared Docker Compose / local development defaults
# Copy to `.env` and replace secrets before `docker compose up --build`.
# Never commit a real `.env` file.

COMPOSE_PROJECT_NAME=docverify-ai

# Host port mappings
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=4000
POSTGRES_HOST_PORT=5434
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334

# PostgreSQL (used by the postgres service and DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=docverify_ai

# Backend runtime (service hostnames for the Compose network)
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://postgres:replace-with-strong-db-password@postgres:5432/docverify_ai?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=10485760
QDRANT_URL=http://qdrant:6333

# Optional seed controls (keep disabled for production-like Compose runs)
SEED_ENABLED=false
ALLOW_PRODUCTION_SEED=false
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_REVIEWER_NAME=Procurement Reviewer
SEED_REVIEWER_EMAIL=reviewer@example.com
SEED_REVIEWER_PASSWORD=change-me-reviewer-password
SEED_SUPPLIER_NAME=Supplier Contact
SEED_SUPPLIER_EMAIL=supplier@example.com
SEED_SUPPLIER_PASSWORD=change-me-supplier-password
SEED_SUPPLIER_COMPANY_NAME=Northwind Supplies Ltd
SEED_SUPPLIER_LEGAL_NAME=Northwind Supplies Ltd
SEED_SUPPLIER_TRADING_NAME=Northwind Supplies
SEED_SUPPLIER_REGISTRATION_NUMBER=SYN-REG-1001

# Frontend build args (baked into the static bundle)
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_NAME=DocVerify AI
